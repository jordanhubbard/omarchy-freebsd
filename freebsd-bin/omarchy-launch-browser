#!/bin/bash

# omarchy:summary=Launch the selected desktop browser, defaulting to Chromium
# omarchy:args=[url] [--private]

set -euo pipefail

desktop_id=$(env -u BROWSER xdg-settings get default-web-browser 2>/dev/null || true)
if [[ -z $desktop_id ]]; then
  desktop_id=$(xdg-mime query default x-scheme-handler/https 2>/dev/null || true)
fi
desktop_id=${desktop_id:-chromium-browser.desktop}
# gtk-launch resolves XDG application paths (including /usr/local), and expands
# the desktop Exec field correctly without evaluating it as shell source.
if [[ $desktop_id == -* || $desktop_id == */* || $desktop_id == *$'\n'* || $desktop_id != *.desktop ]]; then
  echo 'Invalid default browser desktop ID' >&2
  exit 1
fi
case "$desktop_id" in
  *firefox*|*Firefox*|*zen*) private_flag=--private-window ;;
  *edge*) private_flag=--inprivate ;;
  *) private_flag=--incognito ;;
esac
args=()
for argument in "$@"; do
  if [[ $argument == --private ]]; then args+=("$private_flag"); else args+=("$argument"); fi
done
exec uwsm-app -- gtk-launch -- "$desktop_id" "${args[@]}"
