#!/bin/bash

# omarchy:summary=Print CPU and memory stats for the shell
# omarchy:group=system
# omarchy:args=[--bar-widget]

# kern.cp_time is user nice system interrupt idle, cumulative ticks.
cpu_sample() {
  sysctl -n kern.cp_time | awk '{ total = 0; for (i = 1; i <= NF; i++) total += $i; print $5, total }'
}

# Available memory as the VM system counts it: free, inactive and laundry pages.
memory_kib() {
  local pagesize total free inactive laundry
  pagesize=$(sysctl -n hw.pagesize)
  total=$(( $(sysctl -n hw.physmem) / 1024 ))
  free=$(sysctl -n vm.stats.vm.v_free_count)
  inactive=$(sysctl -n vm.stats.vm.v_inactive_count)
  laundry=$(sysctl -n vm.stats.vm.v_laundry_count 2>/dev/null || echo 0)
  echo "$total $(( (free + inactive + laundry) * pagesize / 1024 ))"
}

bar_widget_stats() {
  local idle total mem_total mem_avail
  read -r idle total < <(cpu_sample)
  printf 'cpu\t%s\t%s\n' "$idle" "$total"

  read -r mem_total mem_avail < <(memory_kib)
  awk -v total="$mem_total" -v avail="$mem_avail" 'BEGIN { if (total > 0) printf "memory\t%.2f\n", ((total - avail) / total) * 100 }'

  sysctl -n vm.loadavg | awk '{ print "load\t" $2 }'
}

case "${1:-}" in
  "")
    ;;
  --bar-widget)
    bar_widget_stats
    exit
    ;;
  *)
    echo "Usage: omarchy-system-stats [--bar-widget]" >&2
    exit 1
    ;;
esac

read -r idle1 total1 < <(cpu_sample)
sleep 0.5
read -r idle2 total2 < <(cpu_sample)
cpu=$(awk -v di="$((idle2 - idle1))" -v dt="$((total2 - total1))" 'BEGIN { if (dt > 0) printf "%.0f%%", 100 - di * 100 / dt; else print "0%" }')

read -r mem_total mem_avail < <(memory_kib)
awk -v cpu="$cpu" -v total="$mem_total" -v avail="$mem_avail" 'BEGIN {
  used = total - avail
  printf "cpu\t%s\n", cpu
  printf "memory\t%.1fGB / %.0fGB\n", used / 1024 / 1024, total / 1024 / 1024
}'
