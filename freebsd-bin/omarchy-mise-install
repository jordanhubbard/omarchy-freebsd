#!/bin/bash

# omarchy:summary=Install a small mise-backed wrapper for a given tool.
# omarchy:args=<package> [command-name [bin-name]]

# FreeBSD wrappers install reviewed native packages on first run. Generic
# mise downloads and unqualified Linux binaries are not release defaults.

if [[ -z $1 ]]; then
  echo "Usage: omarchy-mise-install <package> [command-name [bin-name]]"
  exit 1
fi

package=$1
command=${2:-$1}
bin=${3:-$command}

case "$command" in
  */* | .* | -* | *[[:cntrl:]]*)
    echo "omarchy-mise-install: '$command' is not usable as a command name" >&2
    exit 1
    ;;
esac

mkdir -p "$HOME/.local/bin"
wrapper=$HOME/.local/bin/$command

# Tools FreeBSD packages: command -> package. A wrapper is only reached while
# the package is missing, since /usr/local/bin comes first on PATH.
declare -A freebsd_packages=(
  [codex]=codex
  [crush]=crush
  [gh]=gh
)
# Do not generate a first-run downloader for unqualified Linux binaries.
case "$command" in
  claude|cursor-agent|opencode|muse)
    echo "$command is not qualified for this FreeBSD release; no launcher installed." >&2
    exit 1
    ;;
esac

if [[ -n ${freebsd_packages[$command]:-} ]]; then
  pkg_name=${freebsd_packages[$command]}
  rm -f "$wrapper"
  cat >"$wrapper" <<EOF
#!%%LOCALBASE%%/bin/bash
# $command comes from FreeBSD's $pkg_name package, installed on first run.
if [[ ! -x %%LOCALBASE%%/bin/$bin ]]; then
  echo "Installing $pkg_name from FreeBSD packages..."
  sudo pkg install -y $pkg_name || exit 1
fi
exec %%LOCALBASE%%/bin/$bin "\$@"
EOF
  chmod +x "$wrapper"
  exit 0
fi

# Other tools need a reviewed native package mapping. A generic mise backend
# can download a Linux executable even when its frontend runs on FreeBSD.
echo "No reviewed FreeBSD package mapping for $command; use OctoPkg or pkg." >&2
exit 1
