#!/bin/bash

# omarchy:summary=Update the desktop and system packages from their configured FreeBSD repositories
# omarchy:args=[-y]
# omarchy:examples=omarchy update | omarchy update -y
# omarchy:requires-sudo=true

set -e

# Keep a transcript of the whole update. FreeBSD's script(1) takes the command
# after the log file and always exits with the command's status.
if [[ -z ${OMARCHY_UPDATE_LOGGED:-} ]]; then
  exec env OMARCHY_UPDATE_LOGGED=1 script -q "/tmp/omarchy-update.log" "$0" "$@"
fi

if ! omarchy-update-lock held; then
  exec omarchy-update-lock run "$0" "$@"
fi

product=Omarchy
support=https://github.com/jordanhubbard/omarchy-freebsd/issues
if pkg info -e daemonarchy >/dev/null 2>&1; then
  product=Daemonarchy
  support=https://github.com/jordanhubbard/daemonarchy/issues
fi
printf '\n%s update\n' "$product"
if [[ $product == Daemonarchy ]]; then
  echo 'Desktop updates come from the signed Daemonarchy package repository.'
  echo 'FreeBSD dependencies come from the configured FreeBSD package repositories.'
fi
update_failed() {
  printf '\n%s update failed. Review the output above and retry.\nHelp: %s\n' "$product" "$support" >&2
}
trap update_failed ERR
trap 'omarchy-update-stay-awake stop' EXIT

omarchy-update-requires-free-space

[[ ${1:-} != "-y" ]] || export OMARCHY_UPDATE_UNATTENDED=1

if [[ ${1:-} == "-y" ]] || omarchy-update-confirm; then
  omarchy-update-pkg-prune
  omarchy-snapshot create || (($? == 127)) ||
    echo -e "\e[33mContinuing the update without a snapshot.\e[0m" >&2
  omarchy-update-stay-awake start
  omarchy-update-dev
  omarchy-update-system-pkgs
  omarchy-migrate
  omarchy-hook post-update
  omarchy-update-mise
  omarchy-update-orphan-pkgs
  omarchy-update-status
  omarchy-update-stay-awake stop
  trap - EXIT
  omarchy-update-restart
fi
