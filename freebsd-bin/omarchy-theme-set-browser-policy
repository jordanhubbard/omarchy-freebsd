#!/usr/bin/env bash
# omarchy:summary=Keep administrator-managed browser policies unchanged on FreeBSD
# omarchy:args=<rrggbb>
# omarchy:hidden=true

set -euo pipefail
if (( $# != 1 )) || [[ ! $1 =~ ^[0-9a-f]{6}$ ]]; then
  echo 'Usage: omarchy-theme-set-browser-policy <rrggbb>' >&2
  exit 1
fi

# The upstream helper writes Linux Chrome/Edge/Brave enterprise-policy paths.
# A user theme change must not request root access or alter an administrator's
# managed browser policy. Keep the internal theme hook harmless on FreeBSD.
exit 0
