#!/bin/bash

# omarchy:summary=Bluetooth state and actions for the shell's Bluetooth panel, through FreeBSD's Bluetooth stack
# omarchy:group=bluetooth
# omarchy:args=status | devices | discover | power <on|off|is-on> | <pair|connect|disconnect|forget> <address>
# omarchy:hidden=true

# FreeBSD has no BlueZ. Its own stack (ng_ubt and ng_hci, hccontrol(8),
# hcsecd(8) for link keys and PINs, bthidd(8) for keyboards and mice) covers
# input devices in this backend. A2DP/SBC playback uses base virtual_oss with
# the native Bluetooth backend and a user-session PipeWire OSS adapter.
# Changing anything needs root,
# asked for with pkexec, which Omarchy's polkit rule grants an active local
# wheel session without a password, as BlueZ and NetworkManager do on Arch.
# What the panel polls is kept in world-readable files, so polling never needs
# root.

set -o pipefail

STATE_DIR=/var/db/omarchy-bluetooth
RUN_DIR=/var/run/omarchy-bluetooth
HCSECD_CONF=/etc/bluetooth/hcsecd.conf
BTHIDD_CONF=/etc/bluetooth/bthidd.conf
SELF=%%PREFIX%%/bin/omarchy-bluetooth

audio_stop() {
  if [[ -f $RUN_DIR/audio.pid ]]; then
    pkill -TERM -F "$RUN_DIR/audio.pid" -x virtual_oss 2>/dev/null || true
    local i
    for ((i=0; i<50; i++)); do
      [[ -e /dev/dsp.daemonarchy_bt ]] || break
      sleep .1
    done
  fi
  if [[ -c /dev/dsp.daemonarchy_bt ]]; then
    echo 'Bluetooth audio did not stop; its process and state were retained for diagnosis.' >&2
    return 1
  fi
  rm -f "$RUN_DIR/audio-address" "$STATE_DIR/audio-output"
}

audio_start() {
  local addr=$1 i
  [[ -r %%PREFIX%%/lib/virtual_oss/voss_bt.so ]] || {
    echo 'Bluetooth audio requires the native virtual_oss_bluetooth package.' >&2
    return 1
  }
  if [[ $(cat "$RUN_DIR/audio-address" 2>/dev/null) == "$addr" &&
        -c /dev/dsp.daemonarchy_bt ]]; then
    return 0
  fi
  audio_stop || return
  mkdir -p "$RUN_DIR" "$STATE_DIR"
  chmod 0755 "$RUN_DIR" "$STATE_DIR"
  touch "$RUN_DIR/audio.log"
  chmod 0600 "$RUN_DIR/audio.log"
  # Keep diagnostics private; no microphone capture or shared /dev/dsp alias.
  (umask 077; daemon -f -p "$RUN_DIR/audio.pid" -o "$RUN_DIR/audio.log" \
    /usr/sbin/virtual_oss -C 2 -c 2 -r 48000 -b 16 -s 20ms \
    -R /dev/null -P "/dev/bluetooth/$addr" -d dsp.daemonarchy_bt) || return 1
  for ((i=0; i<50; i++)); do
    if [[ -c /dev/dsp.daemonarchy_bt ]]; then
      printf '%s\n' "$addr" >"$RUN_DIR/audio-address"
      printf '%s\n' "$addr" >"$STATE_DIR/audio-output"
      chmod 0644 "$RUN_DIR/audio-address" "$STATE_DIR/audio-output"
      return 0
    fi
    sleep .1
  done
  audio_stop || return
  echo 'Bluetooth audio could not start; see the root-only Bluetooth audio log.' >&2
  return 1
}

audio_node_ids() {
  timeout 8 pw-dump | jq -r '.[] | select(.type == "PipeWire:Interface:Node" and
    .info.props["node.name"] == "daemonarchy.bluetooth") | .id'
}

audio_unroute() {
  local addr=${1:-} id
  [[ -r $RUN_DIR/audio-address ]] || return 0
  [[ -z $addr || $(cat "$RUN_DIR/audio-address") == "$addr" ]] || return 0
  while read -r id; do
    [[ $id =~ ^[0-9]+$ ]] || continue
    timeout 8 pw-cli destroy "$id" || return
  done < <(audio_node_ids)
}

audio_route() {
  local addr=$1 select_output=${2:-true} properties i
  [[ $(cat "$RUN_DIR/audio-address" 2>/dev/null) == "$addr" ]] || return 0
  # Root starts the OSS backend; the desktop account owns its PipeWire node.
  ((EUID != 0)) || return 0
  for ((i=0; i<30; i++)); do
    timeout 2 pactl info >/dev/null 2>&1 && break
    sleep .2
  done
  if [[ -z $(audio_node_ids) ]]; then
    properties=$(jq -cn '{"factory.name":"freebsd-oss.sink",
      "api.freebsd-oss.dsp-path":"/dev/dsp.daemonarchy_bt",
      "node.name":"daemonarchy.bluetooth", "node.description":"Bluetooth audio (A2DP)",
      "media.class":"Audio/Sink", "object.linger":true,
      "audio.channels":2, "audio.position":["FL","FR"]}')
    timeout 8 pw-cli create-node adapter "$properties" || return
  fi
  for ((i=0; i<30; i++)); do
    if $select_output; then
      timeout 2 pactl set-default-sink daemonarchy.bluetooth 2>/dev/null && return 0
    else
      timeout 2 pactl list short sinks | awk '$2 == "daemonarchy.bluetooth" { found=1 } END { exit !found }' && return 0
    fi
    sleep .2
  done
  echo 'The Bluetooth audio device started, but the desktop audio output is unavailable.' >&2
  return 1
}

# The first HCI node, ubt0hci on a machine with one controller.
hci_node() {
  local node
  node=$(ngctl list 2>/dev/null | awk '$2 ~ /hci$/ { sub(/:$/, "", $2); print $2; exit }')
  [[ -n $node ]] || node=$(cat "$RUN_DIR/node" 2>/dev/null)
  [[ -n $node ]] && echo "$node"
}

hcc() {
  hccontrol -n "$node" "$@"
}

as_root() {
  if ((EUID == 0)); then
    "$SELF" "$@"
  else
    pkexec "$SELF" "$@"
  fi
}

record_state() {
  mkdir -p "$RUN_DIR"
  chmod 0755 "$RUN_DIR"
  node=$(hci_node)
  if [[ -n $node ]] && hcc read_bd_addr >/dev/null 2>&1; then
    echo "$node" >"$RUN_DIR/node"
    hcc read_connection_list 2>/dev/null |
      awk 'NR > 1 && $1 ~ /:/ { print $1 }' >"$RUN_DIR/connected"
    touch "$RUN_DIR/on"
  else
    rm -f "$RUN_DIR/on" "$RUN_DIR/connected"
  fi
}

json_status() {
  local present=false enabled=false discovering=false
  usbconfig 2>/dev/null | grep -qi 'bluetooth' && present=true
  [[ -e $RUN_DIR/node ]] && present=true
  [[ -e $RUN_DIR/on ]] && enabled=true
  [[ -e $RUN_DIR/discovering ]] && discovering=true
  jq -cn --argjson present "$present" --argjson enabled "$enabled" --argjson discovering "$discovering" \
    '{ present: $present, enabled: $enabled, discovering: $discovering }'
}

# Known devices (paired here) and ones the last discovery found, one per
# address: { address, name, paired, connected }.
json_devices() {
  {
    [[ -r $STATE_DIR/known ]] && awk -F '\t' '{ printf "known\t%s\t%s\n", $1, $2 }' "$STATE_DIR/known"
    [[ -r $RUN_DIR/discovered ]] && awk -F '\t' '{ printf "found\t%s\t%s\n", $1, $2 }' "$RUN_DIR/discovered"
    [[ -r $RUN_DIR/connected ]] && awk '{ printf "conn\t%s\t\n", $1 }' "$RUN_DIR/connected"
  } | jq -R -s -c '
    split("\n") | map(select(length > 0) | split("\t")) as $rows
    | ($rows | map(select(.[0] == "conn") | .[1] | ascii_downcase)) as $connected
    | ($rows | map(select(.[0] == "known") | .[1] | ascii_downcase)) as $known
    | $rows | map(select(.[0] != "conn")) | group_by(.[1] | ascii_downcase)
    | map((.[0][1] | ascii_downcase) as $a | {
        address: ($a | ascii_upcase),
        name: (map(.[2]) | map(select(. != null and . != "")) | first // ""),
        paired: ($known | index($a) != null),
        connected: ($connected | index($a) != null)
      })'
}

# ---- root side

require_root() {
  ((EUID == 0)) || { as_root "$@"; exit $?; }
}

enable_services() {
  sysrc -q hcsecd_enable=YES sdpd_enable=YES bthidd_enable=YES >/dev/null
  service hcsecd status >/dev/null 2>&1 || service hcsecd start >/dev/null 2>&1
  service sdpd status >/dev/null 2>&1 || service sdpd start >/dev/null 2>&1
}

discover() {
  local addr name
  node=$(hci_node) || exit 1
  mkdir -p "$RUN_DIR"
  touch "$RUN_DIR/discovering"
  : >"$RUN_DIR/discovered.new"
  # An inquiry of about 10 seconds (8 x 1.28 s), up to 20 devices.
  hcc inquiry 8 20 2>/dev/null | awk '/BD_ADDR:/ { print $2 }' | sort -u |
  while read -r addr; do
    name=$(hcc remote_name_request "$addr" 2>/dev/null | awk -F': ' '/Name:/ { print $2; exit }')
    printf '%s\t%s\n' "$addr" "$name" >>"$RUN_DIR/discovered.new"
  done
  mv "$RUN_DIR/discovered.new" "$RUN_DIR/discovered"
  chmod 0644 "$RUN_DIR/discovered"
  rm -f "$RUN_DIR/discovering"
  record_state
}

# Remove a device's block from an hcsecd/bthidd style config.
drop_block() {
  local file=$1 addr=$2
  [[ -f $file ]] || return 0
  awk -v addr="$addr" '
    /^[[:space:]]*device[[:space:]]*\{/ { block = $0 "\n"; inblock = 1; drop = 0; next }
    inblock { block = block $0 "\n"; if (tolower($0) ~ "bdaddr[[:space:]]+" tolower(addr)) drop = 1
              if ($0 ~ /^[[:space:]]*\}/) { if (!drop) printf "%s", block; inblock = 0 } ; next }
    { print }' "$file" >"$file.new" && mv "$file.new" "$file"
}

known_name() {
  awk -F '\t' -v a="$1" 'tolower($1) == tolower(a) { print $2; exit }' "$RUN_DIR/discovered" "$STATE_DIR/known" 2>/dev/null
}

pair() {
  local addr=$1 name
  node=$(hci_node) || exit 1
  name=$(known_name "$addr")
  enable_services
  # Secure Simple Pairing where the controller has it; the fixed PIN covers
  # older devices that still ask for one.
  hcc write_simple_pairing_mode 1 >/dev/null 2>&1 || true
  drop_block "$HCSECD_CONF" "$addr"
  printf 'device {\n\tbdaddr\t%s;\n\tname\t"%s";\n\tkey\tnokey;\n\tpin\t"0000";\n}\n' "$addr" "${name:-Bluetooth device}" >>"$HCSECD_CONF"
  chmod 0600 "$HCSECD_CONF"
  service hcsecd restart >/dev/null 2>&1
  # bthidd needs the device's HID descriptor, which the device only hands
  # over once paired.
  if bthidcontrol -a "$addr" query >"$RUN_DIR/hid.$$" 2>/dev/null && grep -q 'bdaddr' "$RUN_DIR/hid.$$"; then
    drop_block "$BTHIDD_CONF" "$addr"
    cat "$RUN_DIR/hid.$$" >>"$BTHIDD_CONF"
    service bthidd status >/dev/null 2>&1 && service bthidd restart >/dev/null 2>&1 || service bthidd start >/dev/null 2>&1
  fi
  rm -f "$RUN_DIR/hid.$$"
  mkdir -p "$STATE_DIR"
  awk -F '\t' -v a="$addr" 'tolower($1) != tolower(a)' "$STATE_DIR/known" 2>/dev/null >"$STATE_DIR/known.new"
  printf '%s\t%s\n' "$addr" "${name:-}" >>"$STATE_DIR/known.new"
  mv "$STATE_DIR/known.new" "$STATE_DIR/known"
  chmod 0644 "$STATE_DIR/known"
  record_state
}

connect() {
  node=$(hci_node) || exit 1
  if ! hcc create_connection "$1" >/dev/null 2>&1; then
    # Reconnecting an existing ACL link is normal; other failures are not success.
    if ! hcc read_connection_list 2>/dev/null | awk -v a="$1" \
        'tolower($1) == tolower(a) { found=1 } END { exit !found }'; then
      echo 'Could not establish the Bluetooth connection.' >&2
      return 1
    fi
  fi
  service bthidd status >/dev/null 2>&1 || service bthidd start >/dev/null 2>&1
  # A2DP Audio Sink UUID. A HID-only device must keep its existing path.
  if timeout 8 sdpcontrol -a "$1" search 110b 2>/dev/null | grep -q '(0x110b)'; then
    audio_start "$1" || return
  fi
  record_state
}

disconnect() {
  local handle
  node=$(hci_node) || exit 1
  handle=$(hcc read_connection_list 2>/dev/null | awk -v a="$1" 'tolower($1) == tolower(a) { print $2; exit }')
  [[ -n $handle ]] && hcc disconnect "$handle" >/dev/null 2>&1
  if [[ $(cat "$RUN_DIR/audio-address" 2>/dev/null) == "$1" ]]; then audio_stop || return; fi
  record_state
}

forget() {
  disconnect "$1"
  drop_block "$BTHIDD_CONF" "$1"
  drop_block "$HCSECD_CONF" "$1"
  hcc delete_stored_link_key "$1" >/dev/null 2>&1 || true
  service hcsecd status >/dev/null 2>&1 && service hcsecd restart >/dev/null 2>&1
  service bthidd status >/dev/null 2>&1 && service bthidd restart >/dev/null 2>&1
  awk -F '\t' -v a="$1" 'tolower($1) != tolower(a)' "$STATE_DIR/known" 2>/dev/null >"$STATE_DIR/known.new" &&
    mv "$STATE_DIR/known.new" "$STATE_DIR/known"
  record_state
}

power() {
  local dev
  case $1 in
    is-on) [[ -e $RUN_DIR/on ]]; return ;;
    on)
      for dev in $(ngctl list 2>/dev/null | awk '$2 ~ /^ubt[0-9]+:$/ { sub(/:$/, "", $2); print $2 }'); do
        service bluetooth start "$dev" >/dev/null 2>&1
      done
      ;;
    off)
      audio_stop || return
      for dev in $(ngctl list 2>/dev/null | awk '$2 ~ /^ubt[0-9]+:$/ { sub(/:$/, "", $2); print $2 }'); do
        service bluetooth stop "$dev" >/dev/null 2>&1
      done
      ;;
  esac
  record_state
}

valid_address() {
  [[ ${1:-} =~ ^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$ ]] || {
    echo "Usage: omarchy-bluetooth <pair|connect|disconnect|forget> <address>" >&2
    exit 1
  }
}

case ${1:-} in
  status) json_status ;;
  devices) json_devices ;;
  refresh) require_root refresh; record_state ;;
  discover) require_root discover; discover ;;
  power)
    [[ ${2:-} == is-on ]] && { power is-on; exit; }
    [[ ${2:-} == on || ${2:-} == off ]] || { echo "Usage: omarchy-bluetooth power <on|off|is-on>" >&2; exit 1; }
    if [[ $2 == off ]] && ((EUID != 0)); then audio_unroute || exit; fi
    require_root power "$2"
    power "$2"
    ;;
  connect)
    valid_address "${2:-}"
    address=${2^^}
    if ((EUID == 0)); then
      connect "$address"
    else
      as_root connect "$address" && audio_route "$address"
    fi
    ;;
  restore-audio)
    address=$(cat "$STATE_DIR/audio-output" 2>/dev/null) || exit 0
    valid_address "$address"
    if ((EUID == 0)); then connect "$address"; else as_root connect "$address" && audio_route "$address" false; fi
    ;;
  pair | disconnect | forget)
    valid_address "${2:-}"
    address=${2^^}
    if [[ $1 != pair ]] && ((EUID != 0)); then audio_unroute "$address" || exit; fi
    require_root "$1" "$address"
    "$1" "$address"
    ;;
  *)
    echo "Usage: omarchy-bluetooth status | devices | discover | power <on|off|is-on> | <pair|connect|disconnect|forget> <address>" >&2
    exit 1
    ;;
esac
