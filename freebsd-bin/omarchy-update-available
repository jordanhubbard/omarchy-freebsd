#!/bin/bash

# omarchy:summary=Check whether desktop updates are available from the package repository.

set -euo pipefail

updates=()

if [[ $OMARCHY_PATH != "%%DATADIR%%" ]]; then
  upstream=$(git -C "$OMARCHY_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)

  if [[ -n $upstream ]]; then
    GIT_TERMINAL_PROMPT=0 timeout 10 git -C "$OMARCHY_PATH" fetch --quiet 2>/dev/null || true
    behind=$(git -C "$OMARCHY_PATH" rev-list --count "HEAD..$upstream" 2>/dev/null || echo 0)
    if (( behind > 0 )); then
      commit_label=commits
      (( behind == 1 )) && commit_label=commit
      updates+=("omarchy-dev-checkout $behind new $commit_label on $upstream")
    fi
  fi
fi

# Compare against the last fetched catalog; refreshing it needs root and is
# done by omarchy-update (and by periodic(8) when enabled).
product=Omarchy
packages=(omarchy)
repository=()
if pkg info -e daemonarchy >/dev/null 2>&1; then
  product=Daemonarchy
  packages=(daemonarchy omarchy)
  repository=(-r Daemonarchy)
fi
for package in "${packages[@]}"; do
  installed=$(pkg query '%v' "$package" 2>/dev/null || true)
  if ! available=$(pkg rquery -U "${repository[@]}" '%v' "$package" 2>/dev/null); then
    echo "Cannot check $product updates in the local catalog. Run omarchy update to refresh it." >&2
    exit 2
  fi
  available=$(head -n 1 <<<"$available")
  if [[ -n $installed && -n $available && $(pkg version -t "$installed" "$available") == "<" ]]; then
    updates+=("$product: $package $installed -> $available")
  fi
done

if (( ${#updates[@]} > 0 )); then
  printf '%s\n' "${updates[@]}"
  exit 0
else
  echo "$product is up to date"
  exit 1
fi
