#!%%LOCALBASE%%/bin/bash

# Turn an Omarchy source tree into the FreeBSD tree this port installs.
#
#   freebsdize --in-place <tree>
#       The rewrites the port's build applies after patching: Arch paths to
#       FreeBSD ones, and the compat tools and GNU userland on the PATH of
#       every Omarchy command.
#
#   freebsdize <checkout> <dest>
#       Everything the port's build does to a checkout, for "omarchy dev
#       link": copy it to <dest>, apply the port's patches, add the FreeBSD
#       versions of commands, fix interpreter paths, then the rewrites above.
#
# The values below are filled in when the port is built.

set -euo pipefail

DATADIR="%%DATADIR%%"
PREFIX="%%PREFIX%%"
LOCALBASE="%%LOCALBASE%%"
PREFIX_SHARE="%%PREFIX_SHARE%%"
GNU_COREUTILS="%%GNU_COREUTILS%%"
PYTHON_CMD="%%PYTHON_CMD%%"
PERL="%%PERL%%"
DATA_DIRS=(applications config default install migrations shell themes)

# What the installed port carries for dev mode.
PATCHES_DIR=$DATADIR/freebsd/patches
OVERRIDES_DIR=$DATADIR/freebsd/bin

# Placeholders the sources use for install paths. Spelled in pieces so the
# port's own substitution of this file leaves them alone.
P='%%'

desktop_defaults() {
  local tree=$1
  # Only these upstream application entries have a native launch path. Web
  # services use Chromium; their names do not imply a Linux desktop binary.
  local app
  for app in "$tree"/applications/*.desktop; do
    [[ -f $app ]] || continue
    case ${app##*/} in
      Basecamp.desktop|Discord.desktop|"Disk Usage.desktop"|"Google Contacts.desktop"|"Google Maps.desktop"|"Google Messages.desktop"|"Google Photos.desktop"|HEY.desktop|WhatsApp.desktop|X.desktop|YouTube.desktop|Zoom.desktop|foot.desktop|imv.desktop|mpv.desktop) ;;
      *) rm -f "$app" ;;
    esac
  done
  if [[ -f $tree/default/omarchy/omarchy-menu.jsonc ]]; then
    "$PYTHON_CMD" - "$tree/default/omarchy/omarchy-menu.jsonc" <<'PYMENU'
import json
import pathlib
import re
import sys
path = pathlib.Path(sys.argv[1])
# Installation/removal goes through FreeBSD's repository UI. Upstream's
# individual installers contain more Linux assumptions than package names.
keep_install = {"install.package", "install.webapp", "install.tui",
                "install.style", "install.style.theme", "install.style.background"}
keep_remove = {"remove.package", "remove.webapp", "remove.tui", "remove.theme"}
unsupported = (
    "style.unlock", "system.hibernate", "setup.direct-boot", "setup.reset",
    "setup.security", "setup.network.dns", "setup.network.qr", "setup.default.agent",
    "trigger.capture.screenrecord", "trigger.toggle.crash-capture",
    "trigger.hardware.hybrid-gpu", "trigger.hardware.touchpad-haptics",
    "trigger.share", "update.channel", "update.config.plymouth",
    "update.firmware", "update.password.drive", "update.hardware",
    "setup.default.browser.chrome", "setup.default.browser.brave",
    "setup.default.browser.brave-origin", "setup.default.browser.edge",
    "setup.default.browser.zen", "setup.default.editor.cursor",
    "setup.default.editor.sublime",
    "trigger.tests.network-speedtest", "trigger.tests.disk-speedtest",
)
rows = []
blocked_commands = {"omarchy-dns", "omarchy-network-band", "omarchy-network-qr",
                    "omarchy-network-password", "omarchy-network-speedtest",
                    "omarchy-disk-speedtest", "omarchy-dev-install-ydoo",
                    "omarchy-dev-pkg-test"}
retained_commands = set()
for line in path.read_text().splitlines():
    stripped = line.strip().rstrip(",")
    if not stripped.startswith('"'):
        rows.append(line)
        continue
    entry = json.loads("{" + stripped + "}")
    key, value = next(iter(entry.items()))
    if (key.startswith("install.") and key not in keep_install
            or key.startswith("remove.") and key not in keep_remove
            or any(key == prefix or key.startswith(prefix + ".") for prefix in unsupported)):
        blocked_commands.update(re.findall(r"omarchy-[a-zA-Z0-9-]+", value.get("action", "")))
        continue
    retained_commands.update(re.findall(r"omarchy-[a-zA-Z0-9-]+", value.get("action", "")))
    if key == "learn.arch":
        value.update(icon="", label="FreeBSD Handbook", action="omarchy-launch-browser https://docs.freebsd.org/en/books/handbook/")
    elif key == "learn.omarchy":
        value.update(label="Daemonarchy", action="omarchy-launch-browser https://github.com/jordanhubbard/daemonarchy/blob/main/docs/getting-started.md")
    elif key == "learn.community":
        value.update(label="Daemonarchy Issues", action="omarchy-launch-browser https://github.com/jordanhubbard/daemonarchy/issues")
    elif key in {"setup.default.editor.helix", "setup.default.editor.zed"}:
        old, new = ("helix", "hx") if key.endswith(".helix") else ("zeditor", "zedit")
        for field in ("action", "when", "checked"):
            value[field] = value.get(field, "").replace(old, new)
    elif key == "update.omarchy":
        value["label"] = "Daemonarchy"
    elif key in {"install.package", "remove.package"}:
        value.update(icon="󰏖", label="Packages", action="uwsm-app -- octopkg")
    rows.append("  " + json.dumps(key) + ": " + json.dumps(value, ensure_ascii=False, separators=(",", ":")) + ",")
path.write_text("\n".join(rows) + "\n")
# Keep packaged filenames for compatibility but hide unsupported CLI routes and
# fail before touching services, disks or downloading Linux software.
bin_dir = path.parents[2] / "bin"
for name in blocked_commands - retained_commands:
    if name.startswith("omarchy-launch-") or not (bin_dir / name).is_file():
        continue
    (bin_dir / name).write_text(
        "#!/bin/sh\n# omarchy:hidden=true\n"
        "printf '%s\\n' 'This upstream action is not supported on FreeBSD. Use Daemonarchy Packages or native FreeBSD tools.' >&2\n"
        "exit 1\n")
PYMENU
  fi
  # Bindings are also user-facing launch points. Keep useful keys only where
  # this release supplies a native application/action.
  local bindings
  for bindings in "$tree"/default/hypr/bindings/*.lua; do
    [[ -f $bindings ]] || continue
    sed -i '' -E '/o\.bind.*(omarchy-launch-docker-tui|omarchy-capture-screenrecording|omarchy-capture-webcam-resize|omarchy-menu toggle share|omarchy-agent --pick|omarchy = "(spotify|1password|signal)")/d' "$bindings"
    sed -i '' 's/"Omarchy menu"/"Daemonarchy menu"/g' "$bindings"
  done
  if [[ -f $tree/bin/omarchy-default-editor ]]; then
    sed -i '' -e 's/zeditor/zedit/g' -e 's/helix/hx/g' "$tree/bin/omarchy-default-editor"
  fi
  if [[ -f $tree/install/user/first-run/welcome.sh ]]; then
    sed -i '' 's/Omarchy Menu/Daemonarchy Menu/g' "$tree/install/user/first-run/welcome.sh"
  fi
  # First-run setup must not regenerate Linux downloader wrappers.
  if [[ -f $tree/install/user/mise.sh ]]; then
    printf '%s\n' 'omarchy-mise-install codex' 'omarchy-mise-install crush' 'omarchy-mise-install gh' >"$tree/install/user/mise.sh"
  fi
  # Keep the metadata format and omarchy-* binaries the router discovers.
  # Only its public routes/help use Daemonarchy's name.
  if [[ -f $tree/bin/omarchy ]]; then
    sed -e 's/omarchy /daemonarchy /g' -e 's/Omarchy/Daemonarchy/g' "$tree/bin/omarchy" |
      awk '
        /for file in .*\/omarchy-\*; do/ {
          print "  for file in \"$OMARCHY_BIN_DIR\"/omarchy-* \"$OMARCHY_BIN_DIR\"/daemonarchy-*; do"; next
        }
        /for file in .*\/omarchy-\$group.*-\*; do/ {
          print "  for file in \"$OMARCHY_BIN_DIR/omarchy-$group\"-* \"$OMARCHY_BIN_DIR/daemonarchy-$group\"-*; do"; next
        }
        $0 == "  [[ -x $OMARCHY_BIN_DIR/omarchy-$group ]] && return 0" {
          print "  [[ -x $OMARCHY_BIN_DIR/omarchy-$group || -x $OMARCHY_BIN_DIR/daemonarchy-$group ]] && return 0"; next
        }
        /^  if \[\[ -f \$OMARCHY_BIN_DIR\/omarchy-\$group / {
          print "  if [[ -f $OMARCHY_BIN_DIR/daemonarchy-$group && -x $OMARCHY_BIN_DIR/daemonarchy-$group ]]; then"
          print "    register_command \"$OMARCHY_BIN_DIR/daemonarchy-$group\""
          print "  fi"
        }
        /^    binary="omarchy-/ {
          print "    local binary_prefix"
          print "    for binary_prefix in daemonarchy omarchy; do"
          sub(/omarchy-/, "$binary_prefix-")
          direct_loop = 1
        }
        direct_loop && $0 == "  done" { print "    done"; direct_loop = 0 }
        { print }
        /local stem=.*file_binary#omarchy-/ { print "  stem=${stem#daemonarchy-}" }
        /metadata_value=.*BASH_REMATCH/ { print "      metadata_value=${metadata_value//omarchy /daemonarchy }" }
      ' >"$tree/bin/daemonarchy"
    chmod +x "$tree/bin/daemonarchy"
  fi
}

rewrite() {
  local tree=$1 d dirs=()
  desktop_defaults "$tree"
  for d in bin "${DATA_DIRS[@]}" etc; do
    [[ -d $tree/$d ]] && dirs+=("$tree/$d")
  done
  local files
  files=$(find "${dirs[@]}" -type f \( -path "$tree/themes/*" -prune -o -print0 \) |
    xargs -0 grep -lIE "/usr/(share|bin|lib)/|/etc/sudoers|${P}(DATADIR|PREFIX|LOCALBASE)${P}|chromium\.desktop" || true)
  [[ -n $files ]] && printf '%s\n' "$files" | tr '\n' '\0' |
    xargs -0 sed -i '' -E \
      -e "s|/usr/share/omarchy|$DATADIR|g" \
      -e "s#/usr/share/($PREFIX_SHARE)([/\" ]|\$)#$PREFIX/share/\1\2#g" \
      -e "s|/usr/bin/omarchy-|$PREFIX/bin/omarchy-|g" \
      -e "s#/usr/bin/(systemctl|systemd-run|timedatectl|powerprofilesctl)#$PREFIX/libexec/omarchy/compat/\1#g" \
      -e "s#/usr/bin/($GNU_COREUTILS|grep|find)([^A-Za-z0-9_.-]|\$)#$PREFIX/libexec/omarchy/gnubin/\1\2#g" \
      -e "s#/usr/bin/(bt-agent|fcitx5|fprintd-list|gtk-update-icon-cache|herdr|hyprctl|pipewire|tailscale|updatedb)#$LOCALBASE/bin/\1#g" \
      -e "s|/usr/lib/systemd/user|$DATADIR/default/systemd/user|g" \
      -e "s|chromium\.desktop|chromium-browser.desktop|g" \
      -e "s#(^|[^l])/etc/sudoers#\1$PREFIX/etc/sudoers#g" \
      -e "s|${P}DATADIR${P}|$DATADIR|g; s|${P}PREFIX${P}|$PREFIX|g; s|${P}LOCALBASE${P}|$LOCALBASE|g"

  # The compat tools and GNU userland on the PATH of every Omarchy command,
  # after the metadata header that the omarchy router reads.
  local f line
  line="case \":\$PATH:\" in *\":$PREFIX/libexec/omarchy/gnubin:\"*) ;; *) PATH=\"$PREFIX/libexec/omarchy/compat:$PREFIX/libexec/omarchy/gnubin:\$PATH\" ;; esac"
  for f in "$tree"/bin/*; do
    head -n 1 "$f" | grep -q '^#!.*bash' || continue
    awk -v line="$line" \
      'NR == 1 { print; next } !done && !/^[[:space:]]*(#|$)/ { print line; print ""; done = 1 } { print } END { if (!done) print line }' \
      "$f" >"$f.new" && mv "$f.new" "$f"
    chmod +x "$f"
  done
}

# What USES=shebangfix does to the port's SHEBANG_FILES.
fix_shebangs() {
  local tree=$1 f
  shopt -s nullglob
  for f in "$tree"/bin/* "$tree"/config/omarchy/hooks/*/* "$tree"/default/systemd/system-sleep/* \
    "$tree"/install/user/first-run/* "$tree"/shell/plugins/*/*.sh "$tree"/shell/services/*.sh; do
    [[ -f $f ]] || continue
    sed -i '' -E \
      -e "1s@^#![[:space:]]*(/usr/bin/env[[:space:]]+bash|/bin/bash|/usr/bin/bash)([[:space:]]|\$)@#!$LOCALBASE/bin/bash\2@" \
      -e "1s@^#![[:space:]]*(/usr/bin/env[[:space:]]+python3?|/usr/bin/python3?)([[:space:]]|\$)@#!$PYTHON_CMD\2@" \
      -e "1s@^#![[:space:]]*(/usr/bin/env[[:space:]]+perl|/usr/bin/perl)([[:space:]]|\$)@#!$PERL\2@" \
      "$f"
  done
  shopt -u nullglob
}

from_checkout() {
  local checkout dest patch failed=0
  checkout=$(realpath "$1")
  dest=$2
  [[ -d $checkout/bin && -d $checkout/default ]] || { echo "$checkout does not look like an Omarchy checkout." >&2; exit 1; }

  rm -rf "$dest.new"
  mkdir -p "$dest.new"
  tar -C "$checkout" --exclude .git -cf - . | tar -C "$dest.new" -xpf -

  for patch in "$PATCHES_DIR"/patch-*; do
    [[ -e $patch ]] || continue
    if ! patch -s -N -p0 -d "$dest.new" -i "$patch" >/dev/null 2>&1; then
      echo "warning: ${patch##*/} does not apply to this checkout" >&2
      failed=1
    fi
  done
  find "$dest.new" \( -name '*.orig' -o -name '*.rej' \) -delete

  cp "$OVERRIDES_DIR"/* "$dest.new/bin/"
  fix_shebangs "$dest.new"
  rewrite "$dest.new"

  # A running session reads from <dest>, so update it in place: copy the new
  # tree over it and remove what the checkout no longer has.
  if [[ -d $dest ]]; then
    (cd "$dest.new" && find . -type f -o -type l | sort) >"$dest.new.files"
    (cd "$dest" && find . -type f -o -type l | sort) | comm -13 "$dest.new.files" - |
      while IFS= read -r gone; do rm -f "$dest/$gone"; done
    tar -C "$dest.new" -cf - . | tar -C "$dest" -xpf -
    rm -rf "${dest:?}.new" "$dest.new.files"
  else
    mv "$dest.new" "$dest"
  fi
  return $failed
}

case ${1:-} in
  --in-place) rewrite "${2:?usage: freebsdize --in-place <tree>}" ;;
  -h | --help | "") sed -n '3,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *) from_checkout "${1:?}" "${2:?usage: freebsdize <checkout> <dest>}" ;;
esac
