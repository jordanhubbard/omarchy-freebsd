#!%%LOCALBASE%%/bin/bash

# Seed a user's home with Omarchy's defaults on FreeBSD.
#
# On Arch these files ship in /etc/skel and useradd copies them when a user is
# created. FreeBSD's skeleton lives in the base system, so the port stages the
# same tree under %%DATADIR%%/skel and this copies it in on the user's first
# Omarchy session. Existing files are never overwritten; use
# omarchy-reinstall-configs to reset to the shipped defaults.

set -e

skel="%%DATADIR%%/skel"
marker="$HOME/.local/state/omarchy/freebsd-seeded"

[[ ${1:-} == --force ]] || [[ ! -e $marker ]] || exit 0

# A Hyprland started before Omarchy was set up writes its own example config;
# it is not the user's, so Omarchy's replaces it (kept beside it, just in case).
hypr_config="$HOME/.config/hypr/hyprland.lua"
if [[ -f $hypr_config ]] && grep -q 'autogenerated = true' "$hypr_config"; then
  mv "$hypr_config" "$hypr_config.autogenerated"
fi

# Packages built on Omarchy can add their own defaults in
# %%DATADIR%%/skel.d/<package>. They go in ahead of Omarchy's, because cp -n
# keeps any file already there, such as an existing ~/.bashrc.
for extra in "$skel.d"/*/; do
  [[ -d $extra ]] && cp -Rn "$extra." "$HOME/"
done
cp -Rn "$skel/." "$HOME/"

mkdir -p "$(dirname "$marker")"
touch "$marker"
